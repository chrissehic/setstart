generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workflow {
  id                String            @id @default(cuid())
  userId            String
  name              String
  tagline           String?
  description       String?
  logoImage         String?
  backgroundImage   String?
  estimatedDuration String?
  stage             String            @default("existence")
  status            String            @default("BLUEPRINT")
  definition        String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  objectives        Objective[]
  products          Product[]
  people            RolesInWorkflow[]
  tasks             Task[]
  tags              Tag[]             @relation("TagToWorkflow")
  socialLinks       SocialLink[]

  @@unique([userId, name])
}

model Objective {
  id          String   @id @default(cuid())
  workflowId  String
  title       String
  description String?
  priority    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id             String         @id @default(cuid())
  workflowId     String
  objectiveId    String?
  title          String
  category       String
  description    String?
  status         String         @default("NOT_STARTED")
  responsibility String         @default("IN_HOUSE")
  priority       String?
  dueDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assignedPeople PersonOnTask[]
  objective      Objective?     @relation(fields: [objectiveId], references: [id])
  workflow       Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  workflows Workflow[] @relation("TagToWorkflow")
}

model Person {
  id          String            @id @default(cuid())
  name        String            @unique
  avatarImage String?
  tasks       PersonOnTask[]
  workflows   RolesInWorkflow[]
}

model RolesInWorkflow {
  workflowId String
  personId   String
  role       String
  person     Person   @relation(fields: [personId], references: [id])
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@id([workflowId, personId])
}

model PersonOnTask {
  taskId   String
  personId String
  person   Person @relation(fields: [personId], references: [id])
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, personId])
}

model Product {
  id          String           @id @default(cuid())
  workflowId  String
  name        String
  description String?
  type        String?
  image       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workflow    Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String
  description String?
  attributes  String
  price       Float?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SocialLink {
  id         String   @id @default(cuid())
  workflowId String
  name       String
  url        String
  handle     String?
  icon       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, name])
}
