generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workflow {
  id                String            @id @default(cuid())
  userId            String
  name              String
  tagline           String?
  description       String?
  logoImage         String?
  backgroundImage   String?
  tags              Tag[] // Many-to-many relation with Tag
  people            RolesInWorkflow[] // People + roles in this workflow
  estimatedDuration String? // Optional estimated duration

  stage  WorkflowStage  @default(existence)
  status WorkflowStatus @default(BLUEPRINT)

  definition String

  objectives Objective[] // 🚀 Objectives
  tasks      Task[] // 🚀 Tasks
  products   Product[] // 🚀 Products

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

enum WorkflowStage {
  existence
  survival
  success
  takeoff
  maturity
}

enum WorkflowStatus {
  BLUEPRINT
  OPERATIONAL
}

model Objective {
  id         String   @id @default(cuid())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String

  title       String
  description String?
  priority    TaskPriority?

  tasks Task[] // Tasks under this objective

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id         String   @id @default(cuid())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String

  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  objectiveId String?

  title       String
  category    String // e.g., "Photography", "Web Development", etc.
  description String?

  status         TaskStatus     @default(NOT_STARTED)
  responsibility Responsibility @default(IN_HOUSE)
  priority       TaskPriority?

  dueDate DateTime?

  assignedPeople PersonOnTask[] // 🚀 Many-to-many: who is assigned

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  workflows Workflow[]
}

model Person {
  id          String            @id @default(cuid())
  name        String            @unique
  avatarImage String?
  workflows   RolesInWorkflow[]
  tasks       PersonOnTask[] // 🚀 Tasks assigned to this person
}

model RolesInWorkflow {
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String
  person     Person   @relation(fields: [personId], references: [id])
  personId   String
  role       String

  @@id([workflowId, personId])
}

model PersonOnTask {
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String
  person   Person @relation(fields: [personId], references: [id])
  personId String

  @@id([taskId, personId])
}

model Product {
  id          String   @id @default(cuid())
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId  String

  name        String
  description String?
  type        String? // e.g., "SaaS", "Food", "Service", etc.
  image       String? // URL or path to product image
  // Add more fields as needed for flexibility

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum Responsibility {
  IN_HOUSE
  OUTSOURCED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
